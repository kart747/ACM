# Copy to .env.local. Leave the key blank to use prepared stories without Gemini.
# These values are read by the Next.js server, never exposed to the browser.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://api.routing.run/v1
GEMINI_MODEL=gemini-3.8-flash

# Optional, classic mode only: off skips browser-side SAM model downloads.
# NEXT_PUBLIC_ARTSCAPE_SEGMENTATION=off
