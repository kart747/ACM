# Copy to .env and fill in. The Gemini settings are used only by `npm run generate:artscape`,
# never by the web app or the browser.
GEMINI_API_KEY=your-gemini-api-key
# Optional extra keys. When a key hits its rate limit or quota (HTTP 429), generation moves on
# to the next one. Logs name the slot (key-1, key-2, …), never the key.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# Optional. Run `npm run generate:artscape -- --list-models` to see what your key can use.
GEMINI_MODEL=gemini-2.5-flash

# Web app, optional. Motif segmentation backend: `sam2` (default) traces clicked details with
# SAM 2.1 in the browser; `off` keeps the curated rectangles and never downloads the model.
# NEXT_PUBLIC_ARTSCAPE_SEGMENTATION=sam2
